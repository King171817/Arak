generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  fullName        String
  passportNumber  String?
  countryOfOrigin String?
  phoneNumber     String?
  role            String           @default("student")
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  requests         ServiceRequest[]
  uploadedFiles    UploadedFile[]
}

model ServiceRequest {
  id            String   @id @default(cuid())
  requestNumber String   @unique
  userId        String
  type          String
  status        String   @default("pending")
  priority      String   @default("normal")
  details       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model UploadedFile {
  id           String   @id @default(cuid())
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  documentType String
  userId       String
  requestId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])
}

model FloatingMessage {
  id           String    @id @default(cuid())
  title        String?
  message      String
  titleFa      String?
  messageFa    String?
  titleEn      String?
  messageEn    String?
  titleAr      String?
  messageAr    String?
  titleTr      String?
  messageTr    String?
  titleRu      String?
  messageRu    String?
  targetRole   String?
  targetUnit   String?
  targetUserId String?
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DatasetSetting {
  id          String   @id @default(cuid())
  apiUrl      String?
  mockMode    Boolean  @default(false)
  useDatabase Boolean  @default(true)
  provider    String?  @default("sqlite")
  isActive    Boolean  @default(true)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AccessRule {
  id          String   @id @default(cuid())
  userId      String
  role        String
  unit        String?
  permissions String
  isLocked    Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([role])
  @@index([unit])
}

model DailyActivityReport {
  id          String   @id @default(cuid())
  userId      String
  role        String?
  unit        String?
  reportDate  DateTime @default(now())
  title       String?
  description String
  status      String   @default("submitted")
  isLocked    Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([unit])
  @@index([reportDate])
}

model AdminUser {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String?  @unique
  password       String
  fullName       String
  role           String   @default("student")
  unit           String?
  passportNumber String?
  studentNumber  String?
  phoneNumber    String?
  isLocked       Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([username])
  @@index([role])
  @@index([unit])
}