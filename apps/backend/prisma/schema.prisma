generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  fullName        String
  passportNumber  String?
  countryOfOrigin String?
  phoneNumber     String?
  role            String   @default("student")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests      ServiceRequest[]
  uploadedFiles UploadedFile[] // ÃƒËœÃ‚Â§ÃƒËœÃ‚Â¶ÃƒËœÃ‚Â§Ãƒâ„¢Ã‚ÂÃƒâ„¢Ã¢â‚¬Â¡ ÃƒËœÃ‚Â´ÃƒËœÃ‚Â¯ - ÃƒËœÃ‚Â±ÃƒËœÃ‚Â§ÃƒËœÃ‚Â¨ÃƒËœÃ‚Â·Ãƒâ„¢Ã¢â‚¬Â¡ Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚Â¹ÃƒÅ¡Ã‚Â©Ãƒâ„¢Ã‹â€ ÃƒËœÃ‚Â³
}

model ServiceRequest {
  id            String   @id @default(cuid())
  requestNumber String   @unique
  userId        String
  type          String
  status        String   @default("pending")
  priority      String   @default("normal")
  details       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model UploadedFile {
  id           String   @id @default(cuid())
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  documentType String
  userId       String
  requestId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model FloatingMessage {
  id     String @id @default(uuid())
  textFa String
  textEn String
  textAr String

  startAt DateTime
  endAt   DateTime

  roles   String @default("[]")
  units   String @default("[]")
  userIds String @default("[]")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model DatasetSetting {
  id          String   @id @default(uuid())
  apiBaseUrl  String   @default("")
  databaseUrl String   @default("")
  useApi      Boolean  @default(true)
  useMock     Boolean  @default(true)
  updatedBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AccessRule {
  id          String   @id @default(uuid())
  userId      String
  role        String
  unit        String   @default("")
  permissions String   @default("[]")
  isLocked    Boolean  @default(false)
  updatedBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailyActivityReport {
  id          String   @id @default(uuid())
  userId      String
  userName    String
  role        String
  unit        String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
